{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iconocracia",
  "main": "src/index.js",
  "compatibility_date": "2026-07-23",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "site",
    "binding": "ASSETS"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["Sandbox"] },
    { "tag": "v2", "deleted_classes": ["Sandbox"] }
  ]
}
