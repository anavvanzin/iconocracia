{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iconocracia.com/schemas/jogo.schema.json",
  "title": "FUNDIÇÃO — manifest de lotes do arcade",
  "description": "Lotes elegíveis para o arcade /jogo. Cada lote carrega a matriz por eixo (valores ordinais 0-3) e a proveniência da codificação. Nenhum campo agrega os dez eixos.",
  "type": "object",
  "required": [
    "schema_version",
    "eixos",
    "lotes",
    "meta"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "mnemosyne-viva/jogo@1"
    },
    "eixos": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "description": "Os dez indicadores de purificação, em ordem canônica.",
      "items": {
        "type": "object",
        "required": [
          "chave",
          "nome",
          "tratamento"
        ],
        "additionalProperties": false,
        "properties": {
          "chave": {
            "type": "string"
          },
          "nome": {
            "type": "string"
          },
          "tratamento": {
            "type": "string"
          }
        }
      }
    },
    "lotes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "etapa",
          "ordem",
          "year",
          "regime",
          "titulo",
          "suporte",
          "pais",
          "image",
          "matriz",
          "carimbos",
          "segundos",
          "citacao",
          "fonte_url",
          "direitos",
          "codificacao",
          "escopo"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "etapa": {
            "enum": [
              "fundacional",
              "normativo",
              "militar",
              "contra-alegoria"
            ]
          },
          "ordem": {
            "type": "integer",
            "minimum": 1
          },
          "year": {
            "type": [
              "integer",
              "null"
            ]
          },
          "regime": {
            "type": "string"
          },
          "titulo": {
            "type": "string"
          },
          "suporte": {
            "type": "string"
          },
          "pais": {
            "type": "string"
          },
          "image": {
            "type": "string",
            "pattern": "^assets/acervo/.+\\.webp$"
          },
          "matriz": {
            "type": "object",
            "description": "Valor-alvo por eixo, escala ordinal 0-3.",
            "minProperties": 10,
            "maxProperties": 10,
            "additionalProperties": {
              "type": "integer",
              "minimum": 0,
              "maximum": 3
            }
          },
          "carimbos": {
            "type": "integer",
            "minimum": 1
          },
          "inicio": {
            "type": "integer",
            "minimum": 0,
            "maximum": 3,
            "description": "Valor inicial de cada eixo. 0 nas etapas de purificação; 3 na etapa contra-alegoria, onde a figura começa na máxima fixidez e o jogador recusa."
          },
          "segundos": {
            "type": "integer",
            "minimum": 10
          },
          "citacao": {
            "type": "string",
            "minLength": 1
          },
          "fonte_url": {
            "type": "string"
          },
          "direitos": {
            "type": [
              "string",
              "null"
            ]
          },
          "escopo": {
            "enum": [
              "nucleo",
              "comparador",
              "icone"
            ]
          },
          "nota_escopo": {
            "type": "string",
            "description": "Nota de escopo: por que o lote entra no jogo fora do recorte Brasil 1822-1922. Só existe para os lotes de comparador e de ícone."
          },
          "codificacao": {
            "type": "object",
            "required": [
              "coded_by",
              "coded_at",
              "regime_justificativa",
              "notas"
            ],
            "additionalProperties": false,
            "properties": {
              "coded_by": {
                "type": "string",
                "minLength": 1
              },
              "coded_at": {
                "type": "string"
              },
              "regime_justificativa": {
                "type": "string"
              },
              "notas": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "meta": {
      "type": "object",
      "required": [
        "corpus_version",
        "total_lotes",
        "excluidos"
      ],
      "additionalProperties": false,
      "properties": {
        "gerado_em": {
          "type": "string",
          "description": "Opcional. Só é escrito quando --stamp informa um valor explícito, para que a geração permaneça byte-idêntica entre execuções."
        },
        "corpus_version": {
          "type": "string"
        },
        "total_lotes": {
          "type": "integer",
          "minimum": 0
        },
        "excluidos": {
          "type": "object",
          "description": "IDs descartados por regra, com a contagem por motivo.",
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
