{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://iconocracia.com/schemas/corpus-data-enriched.schema.json",
  "title": "Mnemosyne Viva — Corpus enriquecido",
  "description": "Esquema do arquivo site/data/corpus-data-enriched.json: um array de itens do acervo. Mantém compatibilidade retroativa com os itens já publicados e documenta o objeto opcional iconographic_metadata (metodologia ICONOCRACIA).",
  "type": "array",
  "items": {
    "$ref": "#/definitions/corpusItem"
  },
  "definitions": {
    "corpusItem": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "title",
        "country",
        "date",
        "regime",
        "url",
        "motif"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "Identificador estável: prefixo de país (ex.: FR-001) ou UUID para itens re-keyed.",
          "pattern": "^([A-Z]{2,}(-[A-Z0-9]+)+|[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12})$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "description": "Data textual (ano, 'c. 1900', intervalos)."
        },
        "year": {
          "type": [
            "integer",
            "string",
            "null"
          ]
        },
        "period": {
          "type": "string"
        },
        "period_norm": {
          "type": "string"
        },
        "creator": {
          "type": "string"
        },
        "institution": {
          "type": "string"
        },
        "source_archive": {
          "type": "string"
        },
        "country": {
          "type": "string"
        },
        "country_pt": {
          "type": "string"
        },
        "medium": {
          "type": "string"
        },
        "medium_norm": {
          "type": "string"
        },
        "motif": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motif_str": {
          "type": "string"
        },
        "regime": {
          "type": "string"
        },
        "regime_justificativa": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "rights": {
          "type": "string"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags_str": {
          "type": "string"
        },
        "citation_abnt": {
          "type": "string"
        },
        "citation_chicago": {
          "type": "string"
        },
        "local_image_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "iiif_note": {
          "type": [
            "string",
            "null"
          ]
        },
        "iiif_source": {
          "type": [
            "string",
            "null"
          ]
        },
        "url": {
          "type": [
            "string",
            "null"
          ],
          "description": "URL da ficha no arquivo de origem (http/https) ou null quando indisponível.",
          "pattern": "^(https?://|$)"
        },
        "url_iiif": {
          "type": [
            "string",
            "null"
          ]
        },
        "url_image_download": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://|$)"
        },
        "thumbnail_url": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^(https?://|$)"
        },
        "iconographic_metadata": {
          "$ref": "#/definitions/iconographicMetadata"
        }
      }
    },
    "iconographicMetadata": {
      "type": "object",
      "description": "Metadados iconográficos opcionais da metodologia ICONOCRACIA. Todos os campos são opcionais; nomes canônicos são obrigatórios (additionalProperties: false).",
      "additionalProperties": false,
      "properties": {
        "allegorical_figure": {
          "type": "string",
          "description": "Figura alegórica identificada (ex.: 'República', 'Liberdade')."
        },
        "iconclass": {
          "description": "Notação(ões) Iconclass. String única ou lista.",
          "oneOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ]
        },
        "attributes": {
          "type": "array",
          "description": "Atributos visuais (barrete frígio, ramo, espada, etc.).",
          "items": {
            "type": "string"
          }
        },
        "pathosformel": {
          "type": "string",
          "description": "Pathosformel warburguiana associada ao gesto/afeto."
        },
        "visual_regime": {
          "type": "string",
          "description": "Regime visual (fundacional, normativo, militar, contra-alegoria)."
        },
        "state_function": {
          "type": "string",
          "description": "Função de Estado que a imagem desempenha."
        },
        "contract_visual_sexual": {
          "type": "string",
          "description": "Leitura do contrato visual-sexual encenado pela imagem."
        },
        "coloniality_of_seeing": {
          "type": "string",
          "description": "Nota sobre a colonialidade do ver mobilizada."
        },
        "purification_indicators": {
          "type": "array",
          "description": "Indicadores de purificação/branqueamento simbólico.",
          "items": {
            "type": "string"
          }
        },
        "atlas_panel": {
          "type": "string",
          "description": "Painel do Atlas (Mnemosyne) ao qual o item pertence."
        },
        "panofsky": {
          "type": "object",
          "description": "Anotação Panofsky em 3 níveis propagada do master record (records.jsonl iconocode).",
          "additionalProperties": false,
          "properties": {
            "pre_iconographic": {
              "type": "array",
              "description": "Nível pré-iconográfico: motivos observados.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "motif": {
                    "type": "string"
                  },
                  "observed": {
                    "type": "boolean"
                  },
                  "notes": {
                    "type": "string"
                  }
                },
                "required": [
                  "motif",
                  "observed"
                ]
              }
            },
            "codes": {
              "type": "array",
              "description": "Nível iconográfico: códigos de classificação (Iconclass, AAT, TGN, ULAN).",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "scheme": {
                    "type": "string",
                    "enum": [
                      "iconclass",
                      "getty_aat",
                      "tgn",
                      "ulan",
                      "custom"
                    ]
                  },
                  "notation": {
                    "type": "string"
                  },
                  "label": {
                    "type": "string"
                  },
                  "code_role": {
                    "type": "string",
                    "enum": [
                      "depicts",
                      "attribute",
                      "context",
                      "style"
                    ]
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "evidence_source_id": {
                    "type": "string"
                  }
                },
                "required": [
                  "scheme",
                  "notation",
                  "code_role",
                  "confidence"
                ]
              }
            },
            "interpretation": {
              "type": "array",
              "description": "Nível iconológico: claims interpretativos com status e confiança.",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "claim_text": {
                    "type": "string"
                  },
                  "claim_type": {
                    "type": "string",
                    "enum": [
                      "iconographic",
                      "legal_context",
                      "dating",
                      "attribution",
                      "postcolonial_marker"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "supported",
                      "tentative",
                      "gap"
                    ]
                  },
                  "confidence": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  }
                },
                "required": [
                  "claim_text",
                  "claim_type",
                  "status",
                  "confidence"
                ]
              }
            },
            "confidence": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "description": "Confiança agregada da codificação IconoCode."
            }
          }
        }
      }
    }
  }
}
